<Page
    x:Class="EdmgStudio.WinUI.Pages.WorkspacePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:EdmgStudio.WinUI.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="WorkspaceCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="20" />
        </Style>
        <Style x:Key="WorkspaceSectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Page.Resources>

    <Grid Padding="24,20,24,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Workspace" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Shape source media, project health, analysis, storyboards, and handoffs from one native workbench."
                    TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <ProgressRing
                    x:Name="WorkspaceProgressRing"
                    Width="22"
                    Height="22"
                    IsActive="False"
                    Visibility="Collapsed" />
                <Button
                    x:Name="RefreshWorkspaceButton"
                    AccessKey="R"
                    AutomationProperties.AutomationId="Workspace.RefreshAll"
                    Click="RefreshWorkspaceButton_Click"
                    Content="Refresh workspace"
                    ToolTipService.ToolTip="Reload project details, assets, health, and live summaries" />
            </StackPanel>
        </Grid>

        <InfoBar
            x:Name="StatusInfoBar"
            Grid.Row="1"
            Margin="0,16,0,0"
            IsClosable="True"
            IsOpen="False" />

        <SelectorBar
            x:Name="WorkspaceModeSelector"
            Grid.Row="2"
            Margin="0,14,0,14"
            AutomationProperties.AutomationId="Workspace.ModeSelector"
            SelectionChanged="WorkspaceMode_SelectionChanged">
            <SelectorBarItem
                x:Name="OverviewSelectorItem"
                AutomationProperties.AutomationId="Workspace.Mode.Overview"
                Icon="Home"
                Text="Overview" />
            <SelectorBarItem
                x:Name="StoryboardSelectorItem"
                AutomationProperties.AutomationId="Workspace.Mode.Storyboard"
                Icon="Video"
                Text="Storyboard" />
            <SelectorBarItem
                x:Name="DirectorSelectorItem"
                AutomationProperties.AutomationId="Workspace.Mode.Director"
                Icon="Edit"
                Text="Director" />
            <SelectorBarItem
                x:Name="PlannerSelectorItem"
                AutomationProperties.AutomationId="Workspace.Mode.Planner"
                Icon="Bullets"
                Text="AI Planner" />
            <SelectorBarItem
                x:Name="ReactiveSelectorItem"
                AutomationProperties.AutomationId="Workspace.Mode.Reactive"
                Icon="Refresh"
                Text="Reactive Lab" />
        </SelectorBar>

        <ScrollViewer
            Grid.Row="3"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <Grid x:Name="WorkspaceContentGrid">
                <Grid x:Name="OverviewPanel" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="OverviewPrimaryColumn" Width="*" />
                        <ColumnDefinition x:Name="OverviewSecondaryColumn" Width="400" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition x:Name="OverviewNarrowSecondRow" Height="0" />
                    </Grid.RowDefinitions>

                    <StackPanel x:Name="OverviewPrimaryPanel" Grid.Column="0" Spacing="16">
                        <Border Style="{StaticResource WorkspaceCardStyle}">
                            <StackPanel Spacing="12">
                                <TextBlock Style="{StaticResource WorkspaceSectionTitleStyle}" Text="Project session" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Select the project whose media and generated plan should drive this session."
                                    TextWrapping="Wrap" />
                                <ComboBox
                                    x:Name="ProjectComboBox"
                                    AutomationProperties.AutomationId="Workspace.ProjectSelector"
                                    DisplayMemberPath="Name"
                                    Header="Active project"
                                    HorizontalAlignment="Stretch"
                                    PlaceholderText="Choose a project"
                                    SelectionChanged="ProjectComboBox_SelectionChanged" />
                                <TextBlock
                                    x:Name="ProjectStatusText"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="No project selected."
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Expander
                            x:Name="AudioAnalysisExpander"
                            AutomationProperties.AutomationId="Workspace.AudioAnalysis"
                            Header="Audio and analysis"
                            IsExpanded="True">
                            <Border Margin="0,8,0,0" Style="{StaticResource WorkspaceCardStyle}">
                                <StackPanel Spacing="14">
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="Upload a source track, then run analysis to derive rhythm, sections, tags, and transcript context."
                                        TextWrapping="Wrap" />
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            x:Name="PendingAudioText"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="No audio file selected."
                                            TextTrimming="CharacterEllipsis" />
                                        <Button
                                            x:Name="ChooseAudioButton"
                                            Grid.Column="1"
                                            AccessKey="A"
                                            AutomationProperties.AutomationId="Workspace.Audio.Choose"
                                            Click="ChooseAudioButton_Click"
                                            Content="Choose audio" />
                                        <Button
                                            x:Name="UploadAnalyzeButton"
                                            Grid.Column="2"
                                            AccessKey="U"
                                            AutomationProperties.AutomationId="Workspace.Audio.UploadAnalyze"
                                            Click="UploadAnalyzeButton_Click"
                                            Content="Upload and analyze"
                                            Style="{StaticResource AccentButtonStyle}" />
                                    </Grid>
                                    <Grid ColumnSpacing="18" RowSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold" Text="Tempo" />
                                            <TextBlock x:Name="AnalysisBpmText" Text="—" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock FontWeight="SemiBold" Text="Duration" />
                                            <TextBlock x:Name="AnalysisDurationText" Text="—" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock FontWeight="SemiBold" Text="Sections" />
                                            <TextBlock x:Name="AnalysisSectionCountText" Text="—" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock FontWeight="SemiBold" Text="Analysis summary" />
                                    <TextBlock x:Name="AnalysisSummaryText" Text="Analysis has not been run." TextWrapping="Wrap" />
                                    <TextBlock FontWeight="SemiBold" Text="Transcript status" />
                                    <TextBlock x:Name="TranscriptStatusText" Text="Waiting for analysis." TextWrapping="Wrap" />
                                    <TextBlock FontWeight="SemiBold" Text="Tags" />
                                    <TextBlock x:Name="AnalysisTagsText" Text="No analysis tags." TextWrapping="Wrap" />
                                    <ListView
                                        x:Name="AnalysisSectionsList"
                                        MaxHeight="220"
                                        AutomationProperties.AutomationId="Workspace.Analysis.Sections"
                                        SelectionMode="None">
                                        <ListView.Header>
                                            <TextBlock Margin="12,8" FontWeight="SemiBold" Text="Detected sections" />
                                        </ListView.Header>
                                    </ListView>
                                </StackPanel>
                            </Border>
                        </Expander>

                        <Expander
                            x:Name="ReferenceAssetsExpander"
                            AutomationProperties.AutomationId="Workspace.ReferenceAssets"
                            Header="Reference images and project assets">
                            <Border Margin="0,8,0,0" Style="{StaticResource WorkspaceCardStyle}">
                                <StackPanel Spacing="12">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            x:Name="PendingReferenceText"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="No reference image selected."
                                            TextTrimming="CharacterEllipsis" />
                                        <Button
                                            x:Name="ChooseReferenceButton"
                                            Grid.Column="1"
                                            AccessKey="I"
                                            AutomationProperties.AutomationId="Workspace.Reference.Choose"
                                            Click="ChooseReferenceButton_Click"
                                            Content="Choose image" />
                                        <Button
                                            x:Name="UploadReferenceButton"
                                            Grid.Column="2"
                                            AutomationProperties.AutomationId="Workspace.Reference.Upload"
                                            Click="UploadReferenceButton_Click"
                                            Content="Upload reference"
                                            Style="{StaticResource AccentButtonStyle}" />
                                    </Grid>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Margin="12,6" FontWeight="SemiBold" Text="Asset" />
                                        <TextBlock Grid.Column="1" Margin="12,6" FontWeight="SemiBold" Text="Role" />
                                        <TextBlock Grid.Column="2" Margin="12,6" FontWeight="SemiBold" Text="Availability" />
                                    </Grid>
                                    <Button
                                       x:Name="RefreshAssetsButton"
                                       AutomationProperties.AutomationId="Workspace.Assets.Refresh"
                                       Click="RefreshAssetsButton_Click"
                                       Content="Refresh assets"
                                       HorizontalAlignment="Left" />
                                    <ListView
                                        x:Name="AssetsListView"
                                        MaxHeight="280"
                                        AutomationProperties.AutomationId="Workspace.Assets.List"
                                        ItemsSource="{x:Bind AssetItems, Mode=OneWay}"
                                        SelectionMode="None">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="local:WorkspaceAssetItem">
                                                <Grid ColumnSpacing="8" Padding="12,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="2*" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{x:Bind DisplayName}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Path}" />
                                                    <TextBlock Grid.Column="1" Text="{x:Bind Role}" />
                                                    <TextBlock Grid.Column="2" Text="{x:Bind Availability}" />
                                                    <Button
                                                       Grid.Column="3"
                                                       AutomationProperties.AutomationId="{x:Bind OpenAutomationId}"
                                                       Click="OpenAssetButton_Click"
                                                       Content="Open"
                                                       IsEnabled="{x:Bind CanOpen}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                    <TextBlock
                                        x:Name="AssetEmptyText"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="No project assets were returned."
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Expander>

                        <Expander
                            x:Name="PlanExpander"
                            AutomationProperties.AutomationId="Workspace.Plan"
                            Header="Plan variants"
                            IsExpanded="True">
                            <Border Margin="0,8,0,0" Style="{StaticResource WorkspaceCardStyle}">
                                <StackPanel Spacing="12">
                                    <ComboBox
                                        x:Name="PlanModeComboBox"
                                        AutomationProperties.AutomationId="Workspace.Plan.Mode"
                                        Header="Planning mode"
                                        SelectedIndex="0">
                                        <ComboBoxItem Content="Auto" Tag="auto" />
                                        <ComboBoxItem Content="AI" Tag="ai" />
                                        <ComboBoxItem Content="Local" Tag="local" />
                                    </ComboBox>
                                    <TextBox
                                        x:Name="PlanTitleTextBox"
                                        AutomationProperties.AutomationId="Workspace.Plan.Title"
                                        Header="Direction title"
                                        PlaceholderText="Optional title" />
                                    <TextBox
                                        x:Name="PlanNotesTextBox"
                                        AutomationProperties.AutomationId="Workspace.Plan.Notes"
                                        Header="Creative notes"
                                        MinHeight="86"
                                        AcceptsReturn="True"
                                        PlaceholderText="Describe pacing, visuals, motifs, or story intent"
                                        TextWrapping="Wrap" />
                                    <Button
                                        x:Name="GeneratePlanButton"
                                        AccessKey="G"
                                        AutomationProperties.AutomationId="Workspace.Plan.Generate"
                                        Click="GeneratePlanButton_Click"
                                        Content="Generate plan variants"
                                        HorizontalAlignment="Left"
                                        Style="{StaticResource AccentButtonStyle}" />
                                    <RadioButtons
                                        x:Name="VariantRadioButtons"
                                        AutomationProperties.AutomationId="Workspace.Plan.Variants"
                                        Header="Selected variant"
                                        ItemsSource="{x:Bind VariantItems, Mode=OneWay}"
                                        SelectionChanged="VariantRadioButtons_SelectionChanged">
                                        <RadioButtons.ItemTemplate>
                                            <DataTemplate x:DataType="local:WorkspaceVariantItem">
                                                <StackPanel Margin="0,4" Spacing="2">
                                                    <TextBlock FontWeight="SemiBold" Text="{x:Bind DisplayName}" />
                                                    <TextBlock
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="{x:Bind Summary}"
                                                        TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </RadioButtons.ItemTemplate>
                                    </RadioButtons>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Button
                                            x:Name="ApplyPlanButton"
                                            AccessKey="P"
                                            AutomationProperties.AutomationId="Workspace.Plan.ApplyAppend"
                                            Click="AppendTimelineButton_Click"
                                            Content="Append to timeline"
                                            Style="{StaticResource AccentButtonStyle}" />
                                        <Button
                                            x:Name="OverwritePlanButton"
                                            AutomationProperties.AutomationId="Workspace.Plan.ApplyOverwrite"
                                            Click="OverwriteTimelineButton_Click"
                                            Content="Overwrite timeline" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Expander>
                    </StackPanel>

                    <StackPanel
                        x:Name="OverviewSecondaryPanel"
                        Grid.Column="1"
                        Spacing="16">
                        <Border Style="{StaticResource WorkspaceCardStyle}">
                            <StackPanel Spacing="12">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource WorkspaceSectionTitleStyle}" Text="Project readiness" />
                                    <Button
                                       x:Name="RefreshHealthButton"
                                        Grid.Column="1"
                                       AutomationProperties.AutomationId="Workspace.Health.Refresh"
                                       Click="RefreshHealthButton_Click"
                                       Content="Refresh" />
                                    <Button
                                        x:Name="CollectProjectButton"
                                       Grid.Column="2"
                                        AutomationProperties.AutomationId="Workspace.Health.Collect"
                                        Click="CollectProjectButton_Click"
                                        Content="Collect project" />
                                </Grid>
                                <TextBlock x:Name="HealthStatusText" FontWeight="SemiBold" Text="Health not loaded." TextWrapping="Wrap" />
                                <TextBlock
                                    x:Name="HealthSummaryText"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Select a project to inspect portable asset readiness."
                                    TextWrapping="Wrap" />
                                <TextBlock FontWeight="SemiBold" Text="Missing assets" />
                                <ListView
                                    x:Name="MissingAssetsList"
                                    MaxHeight="160"
                                    AutomationProperties.AutomationId="Workspace.Health.MissingAssets"
                                    SelectionMode="None" />
                                <TextBlock FontWeight="SemiBold" Text="Relink suggestions" />
                                <ListView
                                    x:Name="RelinkSuggestionsList"
                                    MaxHeight="160"
                                    AutomationProperties.AutomationId="Workspace.Health.RelinkSuggestions"
                                    SelectionMode="None" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource WorkspaceCardStyle}">
                            <StackPanel Spacing="10">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource WorkspaceSectionTitleStyle}" Text="Music and live readiness" />
                                    <Button
                                        x:Name="RefreshLiveDataButton"
                                        Grid.Column="1"
                                        AutomationProperties.AutomationId="Workspace.Live.Refresh"
                                        Click="RefreshLiveDataButton_Click"
                                        Content="Refresh" />
                                </Grid>
                                <TextBlock FontWeight="SemiBold" Text="Music Graph" />
                                <TextBlock x:Name="MusicGraphSummaryText" Text="Music Graph is not available." TextWrapping="Wrap" />
                                <ListView
                                    x:Name="MusicGraphSectionsList"
                                    MaxHeight="180"
                                    AutomationProperties.AutomationId="Workspace.MusicGraph.Sections"
                                    SelectionMode="None" />
                                <TextBlock FontWeight="SemiBold" Text="Live cues" />
                                <TextBlock x:Name="LiveCueSummaryText" Text="Live cue summary is not available." TextWrapping="Wrap" />
                                <TextBlock FontWeight="SemiBold" Text="Live assets" />
                                <TextBlock x:Name="LiveAssetSummaryText" Text="Live asset summary is not available." TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Expander
                            AutomationProperties.AutomationId="Workspace.DirectionSummary"
                            Header="Creative direction and Visual DNA">
                            <Border Margin="0,8,0,0" Style="{StaticResource WorkspaceCardStyle}">
                                <StackPanel Spacing="10">
                                    <TextBlock FontWeight="SemiBold" Text="Creative direction" />
                                    <TextBlock x:Name="CreativeDirectionText" Text="No creative direction metadata." TextWrapping="Wrap" />
                                    <TextBlock FontWeight="SemiBold" Text="Visual DNA" />
                                    <TextBlock x:Name="VisualDnaText" Text="No Visual DNA metadata." TextWrapping="Wrap" />
                                    <TextBlock FontWeight="SemiBold" Text="Timeline preview" />
                                    <TextBlock x:Name="TimelinePreviewText" Text="No timeline has been applied." TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Expander>

                        <Border Style="{StaticResource WorkspaceCardStyle}">
                            <StackPanel Spacing="12">
                                <TextBlock Style="{StaticResource WorkspaceSectionTitleStyle}" Text="Specialist handoffs" />
                                <TextBlock
                                    x:Name="HandoffStatusText"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Choose a project to enable workflow handoffs."
                                    TextWrapping="Wrap" />
                                <Grid ColumnSpacing="8" RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Button x:Name="OpenPlannerButton" AutomationProperties.AutomationId="Workspace.Handoff.Planner" Click="NavigatePlannerButton_Click" Content="Planner Lab" HorizontalAlignment="Stretch" />
                                    <Button x:Name="OpenReactiveButton" Grid.Column="1" AutomationProperties.AutomationId="Workspace.Handoff.Reactive" Click="NavigateReactiveButton_Click" Content="Reactive Lab" HorizontalAlignment="Stretch" />
                                    <Button x:Name="OpenTimelineButton" Grid.Row="1" AutomationProperties.AutomationId="Workspace.Handoff.Timeline" Click="NavigateTimelineButton_Click" Content="Timeline" HorizontalAlignment="Stretch" />
                                    <Button x:Name="OpenRenderButton" Grid.Row="1" Grid.Column="1" AutomationProperties.AutomationId="Workspace.Handoff.Render" Click="NavigateRenderButton_Click" Content="Render" HorizontalAlignment="Stretch" />
                                    <Button x:Name="OpenOutputsButton" Grid.Row="2" AutomationProperties.AutomationId="Workspace.Handoff.Outputs" Click="NavigateOutputsButton_Click" Content="Outputs" HorizontalAlignment="Stretch" />
                                    <Button x:Name="OpenQueueButton" Grid.Row="2" Grid.Column="1" AutomationProperties.AutomationId="Workspace.Handoff.Queue" Click="NavigateQueueButton_Click" Content="Queue" HorizontalAlignment="Stretch" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Expander AutomationProperties.AutomationId="Workspace.TemplatePackage" Header="Template package">
                            <Border Margin="0,8,0,0" Style="{StaticResource WorkspaceCardStyle}">
                                <StackPanel Spacing="10">
                                    <Button
                                        x:Name="ExportTemplateButton"
                                        AutomationProperties.AutomationId="Workspace.Template.Export"
                                        Click="ExportTemplateButton_Click"
                                        Content="Preview export package"
                                        HorizontalAlignment="Left" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            x:Name="TemplateFileStatusText"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="Paste JSON or choose a package file."
                                            TextTrimming="CharacterEllipsis" />
                                        <Button
                                            Grid.Column="1"
                                            AutomationProperties.AutomationId="Workspace.Template.Choose"
                                            Click="ChooseTemplateButton_Click"
                                            Content="Choose JSON" />
                                    </Grid>
                                    <TextBox
                                        x:Name="TemplateJsonTextBox"
                                        AutomationProperties.AutomationId="Workspace.Template.Json"
                                        Header="Template JSON"
                                        MinHeight="150"
                                        AcceptsReturn="True"
                                        FontFamily="Consolas"
                                        PlaceholderText="{}{ &quot;schema_version&quot;: 1, &quot;payload&quot;: { ... } }"
                                        TextWrapping="NoWrap" />
                                    <CheckBox
                                        x:Name="TemplateMergeCheckBox"
                                        AutomationProperties.AutomationId="Workspace.Template.Merge"
                                        Content="Merge with existing metadata"
                                        IsChecked="True" />
                                    <Button
                                        x:Name="ImportTemplateButton"
                                        AutomationProperties.AutomationId="Workspace.Template.Import"
                                        Click="ImportTemplateButton_Click"
                                        Content="Validate and import"
                                        HorizontalAlignment="Left"
                                        Style="{StaticResource AccentButtonStyle}" />
                                </StackPanel>
                            </Border>
                        </Expander>

                        <Expander AutomationProperties.AutomationId="Workspace.Inspect" Header="Inspect JSON">
                            <Border Margin="0,8,0,0" Style="{StaticResource WorkspaceCardStyle}">
                                <StackPanel Spacing="10">
                                    <TextBox
                                        x:Name="AnalysisJsonTextBox"
                                        AutomationProperties.AutomationId="Workspace.Inspect.Analysis"
                                        Header="Analysis"
                                        MinHeight="120"
                                        AcceptsReturn="True"
                                        FontFamily="Consolas"
                                        IsReadOnly="True"
                                        TextWrapping="NoWrap" />
                                    <TextBox
                                        x:Name="VariantJsonTextBox"
                                        AutomationProperties.AutomationId="Workspace.Inspect.Variant"
                                        Header="Selected variant"
                                        MinHeight="120"
                                        AcceptsReturn="True"
                                        FontFamily="Consolas"
                                        IsReadOnly="True"
                                        TextWrapping="NoWrap" />
                                    <TextBox
                                        x:Name="LastOperationJsonTextBox"
                                        AutomationProperties.AutomationId="Workspace.Inspect.LastOperation"
                                        Header="Last operation"
                                        MinHeight="100"
                                        AcceptsReturn="True"
                                        FontFamily="Consolas"
                                        IsReadOnly="True"
                                        TextWrapping="NoWrap" />
                                </StackPanel>
                            </Border>
                        </Expander>
                    </StackPanel>
                </Grid>

                <StackPanel x:Name="StoryboardPanel" Visibility="Collapsed" Spacing="16">
                    <Border Style="{StaticResource WorkspaceCardStyle}">
                        <StackPanel Spacing="12">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource WorkspaceSectionTitleStyle}" Text="Storyboard review" />
                                    <TextBlock
                                        x:Name="StoryboardSummaryText"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="Generate and select a plan variant to review its scenes."
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <Button
                                    x:Name="StoryboardAppendButton"
                                    Grid.Column="1"
                                    AutomationProperties.AutomationId="Workspace.Storyboard.ApplyAppend"
                                    Click="AppendTimelineButton_Click"
                                    Content="Append to timeline"
                                    Style="{StaticResource AccentButtonStyle}" />
                                <Button
                                    x:Name="StoryboardOverwriteButton"
                                    Grid.Column="2"
                                    AutomationProperties.AutomationId="Workspace.Storyboard.ApplyOverwrite"
                                    Click="OverwriteTimelineButton_Click"
                                    Content="Overwrite timeline" />
                            </Grid>
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="190" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Margin="12,6" FontWeight="SemiBold" Text="#" />
                                <TextBlock Grid.Column="1" Margin="12,6" FontWeight="SemiBold" Text="Timing" />
                                <TextBlock Grid.Column="2" Margin="12,6" FontWeight="SemiBold" Text="Prompt" />
                                <TextBlock Grid.Column="3" Margin="12,6" FontWeight="SemiBold" Text="Order" />
                            </Grid>
                            <TextBlock
                                x:Name="StoryboardEmptyText"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="The selected variant does not contain storyboard scenes."
                                TextWrapping="Wrap" />
                            <ListView
                                x:Name="StoryboardListView"
                                MinHeight="300"
                                MaxHeight="720"
                                AutomationProperties.AutomationId="Workspace.Storyboard.List"
                                ItemsSource="{x:Bind StoryboardItems, Mode=OneWay}"
                                SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:WorkspaceStoryboardItem">
                                        <Grid ColumnSpacing="10" Padding="12,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="190" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock FontWeight="SemiBold" Text="{x:Bind PositionText}" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind TimingText}" />
                                            <StackPanel Grid.Column="2" Spacing="3">
                                                <TextBlock Text="{x:Bind Prompt}" TextWrapping="Wrap" />
                                                <TextBlock
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{x:Bind NegativePrompt}"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8">
                                                <Button
                                                    AutomationProperties.AutomationId="{x:Bind MoveEarlierAutomationId}"
                                                    Click="MoveSceneEarlierButton_Click"
                                                    Content="Earlier"
                                                    IsEnabled="{x:Bind CanMoveEarlier}"
                                                    Tag="{x:Bind Index}" />
                                                <Button
                                                    AutomationProperties.AutomationId="{x:Bind MoveLaterAutomationId}"
                                                    Click="MoveSceneLaterButton_Click"
                                                    Content="Later"
                                                    IsEnabled="{x:Bind CanMoveLater}"
                                                    Tag="{x:Bind Index}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="DirectorPanel" Visibility="Collapsed" Spacing="16">
                    <Border Style="{StaticResource WorkspaceCardStyle}">
                        <StackPanel Spacing="12">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource WorkspaceSectionTitleStyle}" Text="EDMG Director" />
                                    <TextBlock
                                        x:Name="DirectorSessionText"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="Director uses the active Workspace project, analysis, and selected storyboard."
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <Button
                                    x:Name="OpenFullDirectorButton"
                                    Grid.Column="1"
                                    AutomationProperties.AutomationId="Workspace.Director.OpenFull"
                                    Click="OpenFullDirectorButton_Click"
                                    Content="Open full Director" />
                            </Grid>
                            <Grid ColumnSpacing="12" RowSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    x:Name="WorkspaceDirectorThemeTextBox"
                                    AutomationProperties.AutomationId="Workspace.Director.Theme"
                                    Header="Project theme"
                                    PlaceholderText="Theme, subject, or world" />
                                <TextBox
                                    x:Name="WorkspaceDirectorStyleTextBox"
                                    Grid.Column="1"
                                    AutomationProperties.AutomationId="Workspace.Director.Style"
                                    Header="Visual style"
                                    PlaceholderText="Palette, lens, texture, continuity" />
                            </Grid>
                            <TextBox
                                x:Name="WorkspaceDirectorInstructionTextBox"
                                AutomationProperties.AutomationId="Workspace.Director.Instruction"
                                Header="Direction instruction"
                                AcceptsReturn="True"
                                MinHeight="88"
                                PlaceholderText="Describe the next approved direction pass for this session."
                                TextWrapping="Wrap" />
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    x:Name="WorkspaceDirectorRevisionText"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Revision —" />
                                <Button
                                    Grid.Column="1"
                                    x:Name="UseWorkspaceStoryboardButton"
                                    AutomationProperties.AutomationId="Workspace.Director.UseStoryboard"
                                    Click="UseWorkspaceStoryboardButton_Click"
                                    Content="Use selected storyboard" />
                                <Button
                                    Grid.Column="2"
                                    x:Name="SaveWorkspaceDirectorButton"
                                    AutomationProperties.AutomationId="Workspace.Director.Save"
                                    Click="SaveWorkspaceDirectorButton_Click"
                                    Content="Save direction"
                                    Style="{StaticResource AccentButtonStyle}" />
                                <Button
                                    Grid.Column="3"
                                    x:Name="PrepareWorkspacePromptsButton"
                                    AutomationProperties.AutomationId="Workspace.Director.PreparePrompts"
                                    Click="PrepareWorkspacePromptsButton_Click"
                                    Content="Prepare prompts" />
                            </Grid>
                            <Expander Header="Advanced: SceneSpecs JSON" IsExpanded="False">
                                <TextBox
                                    x:Name="WorkspaceDirectorSceneSpecsTextBox"
                                    AutomationProperties.AutomationId="Workspace.Director.SceneSpecs"
                                    AcceptsReturn="True"
                                    FontFamily="Consolas"
                                    MinHeight="180"
                                    MaxHeight="420"
                                    TextWrapping="Wrap" />
                            </Expander>
                            <ComboBox
                                x:Name="WorkspaceDirectorEngineComboBox"
                                AutomationProperties.AutomationId="Workspace.Director.Engine"
                                Header="Prompt engine"
                                SelectedIndex="0">
                                <ComboBoxItem Content="HunyuanVideo-1.5" Tag="hunyuan_video15" />
                                <ComboBoxItem Content="LTX-2.5" Tag="ltx_25" />
                                <ComboBoxItem Content="External provider" Tag="external" />
                            </ComboBox>
                            <TextBox
                                x:Name="WorkspaceDirectorPromptPreviewTextBox"
                                AutomationProperties.AutomationId="Workspace.Director.PromptPreview"
                                Header="Prepared prompts"
                                AcceptsReturn="True"
                                IsReadOnly="True"
                                MaxHeight="260"
                                TextWrapping="Wrap" />
                            <CommandBar DefaultLabelPosition="Right">
                                <AppBarButton
                                    x:Name="GenerateWorkspaceDirectorButton"
                                    AutomationProperties.AutomationId="Workspace.Director.Generate"
                                    Click="GenerateWorkspaceDirectorButton_Click"
                                    Icon="Play"
                                    Label="Generate draft" />
                                <AppBarButton
                                    x:Name="ReviewWorkspaceDirectorButton"
                                    AutomationProperties.AutomationId="Workspace.Director.Review"
                                    Click="ReviewWorkspaceDirectorButton_Click"
                                    Icon="Refresh"
                                    Label="Review draft" />
                                <AppBarButton
                                    x:Name="ApplyWorkspaceDirectorButton"
                                    AutomationProperties.AutomationId="Workspace.Director.Apply"
                                    Click="ApplyWorkspaceDirectorButton_Click"
                                    Icon="Accept"
                                    IsEnabled="False"
                                    Label="Apply reviewed draft" />
                                <AppBarButton
                                    AutomationProperties.AutomationId="Workspace.Director.Queue"
                                    Click="NavigateQueueButton_Click"
                                    Icon="List"
                                    Label="Open Queue" />
                            </CommandBar>
                            <TextBox
                                x:Name="WorkspaceDirectorDraftTextBox"
                                AutomationProperties.AutomationId="Workspace.Director.Draft"
                                Header="Draft review"
                                AcceptsReturn="True"
                                IsReadOnly="True"
                                MaxHeight="300"
                                TextWrapping="Wrap" />
                            <TextBlock
                                x:Name="WorkspaceDirectorStatusText"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Save direction before preparing prompts or generating a draft."
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="PlannerPanel" Visibility="Collapsed" Spacing="16">
                    <Border Style="{StaticResource WorkspaceCardStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Style="{StaticResource WorkspaceSectionTitleStyle}" Text="AI Planner Lab" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="The full planner runs inside the active Workspace project. Its saved storyboard, scene locks, and planner handoff remain on the same session used by Director, Timeline, and Render."
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Frame
                        x:Name="WorkspacePlannerFrame"
                        AutomationProperties.AutomationId="Workspace.Planner.Frame" />
                </StackPanel>

                <StackPanel x:Name="ReactivePanel" Visibility="Collapsed" Spacing="16">
                    <Border Style="{StaticResource WorkspaceCardStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Style="{StaticResource WorkspaceSectionTitleStyle}" Text="Reactive Lab" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Reactive scheduling runs inside the active Workspace project. Motion curves, cue events, and camera data apply to the same project timeline that Director and Render consume."
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Frame
                        x:Name="WorkspaceReactiveFrame"
                        AutomationProperties.AutomationId="Workspace.Reactive.Frame" />
                </StackPanel>

                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="WorkspaceWidthStates">
                        <VisualState x:Name="WideWorkspace">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="980" />
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="OverviewPrimaryColumn.Width" Value="*" />
                                <Setter Target="OverviewSecondaryColumn.Width" Value="400" />
                                <Setter Target="OverviewNarrowSecondRow.Height" Value="0" />
                                <Setter Target="OverviewSecondaryPanel.(Grid.Row)" Value="0" />
                                <Setter Target="OverviewSecondaryPanel.(Grid.Column)" Value="1" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="NarrowWorkspace">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="0" />
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="OverviewPrimaryColumn.Width" Value="*" />
                                <Setter Target="OverviewSecondaryColumn.Width" Value="0" />
                                <Setter Target="OverviewNarrowSecondRow.Height" Value="Auto" />
                                <Setter Target="OverviewSecondaryPanel.(Grid.Row)" Value="1" />
                                <Setter Target="OverviewSecondaryPanel.(Grid.Column)" Value="0" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
