<Page
    x:Class="EdmgStudio.WinUI.Pages.AiPlannerLabPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="PlannerCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="18" />
        </Style>
        <Style x:Key="PlannerSectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Page.Resources>

    <Grid Padding="24,20,24,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="AI Planner Lab" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Develop creative direction, compare native plan variants, and carry the selected treatment into production."
                    TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <ProgressRing
                    x:Name="PlannerProgressRing"
                    Width="22"
                    Height="22"
                    AutomationProperties.Name="Planner operation progress"
                    IsActive="False"
                    Visibility="Collapsed" />
                <Button
                    x:Name="CancelPlannerButton"
                    AutomationProperties.AutomationId="Planner.Cancel"
                    Click="CancelPlannerButton_Click"
                    Content="Cancel"
                    IsEnabled="False" />
                <Button
                    x:Name="RefreshPlannerButton"
                    AccessKey="R"
                    AutomationProperties.AutomationId="Planner.Refresh"
                    Click="RefreshPlannerButton_Click"
                    Content="Refresh" />
            </StackPanel>
        </Grid>

        <InfoBar
            x:Name="PlannerInfoBar"
            Grid.Row="1"
            Margin="0,16,0,14"
            AutomationProperties.AutomationId="Planner.Status"
            IsClosable="True"
            IsOpen="False" />

        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="14">
                    <Border Style="{StaticResource PlannerCardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Style="{StaticResource PlannerSectionTitleStyle}" Text="Project and engine" />
                            <ComboBox
                                x:Name="ProjectComboBox"
                                AutomationProperties.AutomationId="Planner.Project"
                                DisplayMemberPath="Name"
                                Header="Active project"
                                HorizontalAlignment="Stretch"
                                PlaceholderText="Choose a project"
                                SelectionChanged="ProjectComboBox_SelectionChanged" />
                            <ComboBox
                                x:Name="PlanningModeComboBox"
                                AutomationProperties.AutomationId="Planner.Mode"
                                Header="Planning mode"
                                HorizontalAlignment="Stretch"
                                SelectedIndex="0">
                                <ComboBoxItem Content="Auto" Tag="auto" />
                                <ComboBoxItem Content="AI provider" Tag="ai" />
                                <ComboBoxItem Content="Local rule-based" Tag="local" />
                                <ComboBoxItem Content="EDMG Core" Tag="edmg_core" />
                            </ComboBox>
                            <TextBlock
                                x:Name="ProviderStatusText"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Provider readiness has not been checked."
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PlannerCardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Style="{StaticResource PlannerSectionTitleStyle}" Text="Creative direction" />
                            <TextBox
                                x:Name="TitleTextBox"
                                AutomationProperties.AutomationId="Planner.Title"
                                Header="Plan title"
                                PlaceholderText="A concise treatment title" />
                            <TextBox
                                x:Name="CreativeBriefTextBox"
                                AcceptsReturn="True"
                                AutomationProperties.AutomationId="Planner.CreativeBrief"
                                Header="Creative brief"
                                MinHeight="92"
                                PlaceholderText="Describe the story, emotional arc, and desired result"
                                TextWrapping="Wrap" />
                            <TextBox
                                x:Name="VisualDnaTextBox"
                                AutomationProperties.AutomationId="Planner.VisualDna"
                                Header="Visual DNA"
                                PlaceholderText="Palette, texture, lenses, composition" />
                            <TextBox
                                x:Name="ConstraintsTextBox"
                                AutomationProperties.AutomationId="Planner.Constraints"
                                Header="Constraints"
                                PlaceholderText="Safety, continuity, budget, excluded motifs" />
                            <TextBox
                                x:Name="PromptSeedTextBox"
                                AutomationProperties.AutomationId="Planner.PromptSeed"
                                Header="Prompt seed"
                                PlaceholderText="Subject, location, or visual motif" />
                            <TextBox
                                x:Name="ConductorIntentTextBox"
                                AutomationProperties.AutomationId="Planner.ConductorIntent"
                                Header="Conductor intent"
                                PlaceholderText="How musical structure should drive picture" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PlannerCardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Style="{StaticResource PlannerSectionTitleStyle}" Text="Production presets" />
                            <ComboBox
                                x:Name="DirectorPresetComboBox"
                                AutomationProperties.AutomationId="Planner.DirectorPreset"
                                Header="Director preset"
                                HorizontalAlignment="Stretch"
                                IsEditable="True"
                                PlaceholderText="cinematic"
                                Text="cinematic" />
                            <ComboBox
                                x:Name="MotionPresetComboBox"
                                AutomationProperties.AutomationId="Planner.MotionPreset"
                                Header="Motion preset"
                                HorizontalAlignment="Stretch"
                                IsEditable="True"
                                PlaceholderText="music-driven"
                                Text="music-driven" />
                            <ComboBox
                                x:Name="AnimationPresetComboBox"
                                AutomationProperties.AutomationId="Planner.AnimationPreset"
                                Header="Animation preset"
                                HorizontalAlignment="Stretch"
                                IsEditable="True"
                                PlaceholderText="hybrid"
                                Text="hybrid" />
                            <ComboBox
                                x:Name="RenderPresetComboBox"
                                AutomationProperties.AutomationId="Planner.RenderPreset"
                                Header="Render preset"
                                HorizontalAlignment="Stretch"
                                IsEditable="True"
                                PlaceholderText="preview"
                                Text="preview" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <NumberBox
                                    x:Name="VariantCountNumberBox"
                                    AutomationProperties.AutomationId="Planner.VariantCount"
                                    Header="Variants"
                                    LargeChange="1"
                                    Maximum="10"
                                    Minimum="1"
                                    SmallChange="1"
                                    SpinButtonPlacementMode="Compact"
                                    Value="3" />
                                <NumberBox
                                    x:Name="SceneCountNumberBox"
                                    Grid.Column="1"
                                    AutomationProperties.AutomationId="Planner.SceneCount"
                                    Header="Max scenes"
                                    LargeChange="4"
                                    Maximum="64"
                                    Minimum="1"
                                    SmallChange="1"
                                    SpinButtonPlacementMode="Compact"
                                    Value="12" />
                            </Grid>
                            <Button
                                x:Name="GeneratePlanButton"
                                AccessKey="G"
                                AutomationProperties.AutomationId="Planner.Generate"
                                Click="GeneratePlanButton_Click"
                                Content="Analyze and Build Plan"
                                HorizontalAlignment="Stretch"
                                Style="{StaticResource AccentButtonStyle}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Column="1" RowSpacing="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <CommandBar DefaultLabelPosition="Right">
                    <AppBarButton
                        AutomationProperties.AutomationId="Planner.Import"
                        Click="ImportPlanButton_Click"
                        Icon="OpenFile"
                        Label="Import plan" />
                    <AppBarButton
                        AutomationProperties.AutomationId="Planner.Export"
                        Click="ExportPlanButton_Click"
                        Icon="Save"
                        Label="Export JSON" />
                    <AppBarSeparator />
                    <AppBarButton
                        AutomationProperties.AutomationId="Planner.ApplyTimeline"
                        Click="ApplyTimelineButton_Click"
                        Icon="Accept"
                        Label="Approve Plan and Apply Schedule" />
                    <AppBarButton
                        AutomationProperties.AutomationId="Planner.OpenWorkspace"
                        Click="OpenWorkspaceButton_Click"
                        Icon="Library"
                        Label="Workspace" />
                    <AppBarButton
                        AutomationProperties.AutomationId="Planner.OpenTimeline"
                        Click="OpenTimelineButton_Click"
                        Icon="Forward"
                        Label="Timeline" />
                    <CommandBar.SecondaryCommands>
                        <AppBarButton
                            AutomationProperties.AutomationId="Planner.OpenRender"
                            Click="OpenRenderButton_Click"
                            Label="Open Render" />
                    </CommandBar.SecondaryCommands>
                </CommandBar>

                <Grid Grid.Row="1" ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource PlannerCardStyle}">
                        <Grid RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource PlannerSectionTitleStyle}" Text="Plan variants" />
                            <ListView
                                x:Name="VariantListView"
                                Grid.Row="1"
                                AutomationProperties.AutomationId="Planner.Variants"
                                IsItemClickEnabled="True"
                                ItemClick="VariantListView_ItemClick"
                                SelectionMode="Single">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Padding="2,8" Spacing="3">
                                            <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" TextWrapping="Wrap" />
                                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Summary}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource PlannerCardStyle}">
                        <Grid RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="VariantTitleText" Style="{StaticResource PlannerSectionTitleStyle}" Text="Select a variant" />
                            <TextBlock
                                x:Name="VariantLoglineText"
                                Grid.Row="1"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Generated scene structure and raw backend data will appear here."
                                TextWrapping="Wrap" />
                            <TabView Grid.Row="2" AutomationProperties.AutomationId="Planner.DetailTabs">
                                <TabViewItem Header="Schedule draft" IsClosable="False">
                                    <ScrollViewer>
                                        <StackPanel Padding="12" Spacing="12">
                                            <TextBlock x:Name="ScheduleSummaryText" Text="Select a variant to review its draft." TextWrapping="Wrap" />
                                            <TextBlock x:Name="ScheduleWarningsText" TextWrapping="Wrap" />
                                            <Button x:Name="RegenerateScheduleButton" Content="Regenerate Draft" Click="RegenerateScheduleButton_Click" />
                                            <TextBlock Text="The draft does not change Timeline until you approve it. Manual tracks and locked keyframes are preserved." TextWrapping="Wrap" />
                                            <TextBox x:Name="ScheduleDetailsTextBox" Header="Anchors, musical cues, motion, and continuity" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabViewItem>
                                <TabViewItem Header="Scenes" IsClosable="False">
                                    <Grid ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="280" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ListView
                                            x:Name="SceneListView"
                                            AutomationProperties.AutomationId="Planner.Scenes"
                                            SelectionChanged="SceneListView_SelectionChanged"
                                            SelectionMode="Single">
                                            <ListView.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Padding="4,8" Spacing="3">
                                                        <Grid ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock FontWeight="SemiBold" Text="{Binding Position}" />
                                                            <TextBlock
                                                                Grid.Column="1"
                                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                Text="{Binding TimeRange}" />
                                                        </Grid>
                                                        <TextBlock
                                                            MaxLines="2"
                                                            Text="{Binding Prompt}"
                                                            TextTrimming="CharacterEllipsis"
                                                            TextWrapping="Wrap" />
                                                        <TextBlock
                                                            MaxLines="2"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Text="{Binding MotionSummary}"
                                                            TextTrimming="CharacterEllipsis"
                                                            TextWrapping="Wrap" />
                                                        <TextBlock
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Text="{Binding StateSummary}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>

                                        <Border
                                            Grid.Column="1"
                                            Padding="14"
                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                            CornerRadius="8">
                                            <Grid x:Name="CurationRoot">
                                                <TextBlock
                                                    x:Name="SceneSelectionHint"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="Select a scene to edit timing, prompts, approval, and continuity state."
                                                    TextAlignment="Center"
                                                    TextWrapping="Wrap" />
                                                <ScrollViewer x:Name="SceneEditorPanel" Visibility="Collapsed">
                                                    <StackPanel Spacing="12">
                                                        <Grid ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock x:Name="ScenePositionText" FontWeight="SemiBold" />
                                                                <TextBlock
                                                                    x:Name="SceneStateText"
                                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                                                <Button
                                                                    x:Name="PreviousSceneButton"
                                                                    Click="PreviousSceneButton_Click"
                                                                    Content="Previous" />
                                                                <Button
                                                                    x:Name="NextSceneButton"
                                                                    Click="NextSceneButton_Click"
                                                                    Content="Next" />
                                                            </StackPanel>
                                                        </Grid>

                                                        <Grid ColumnSpacing="10">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <NumberBox
                                                                x:Name="SceneStartNumberBox"
                                                                Header="Start (seconds)"
                                                                Minimum="0"
                                                                SpinButtonPlacementMode="Compact"
                                                                ValueChanged="SceneTimingNumberBox_ValueChanged" />
                                                            <NumberBox
                                                                x:Name="SceneEndNumberBox"
                                                                Grid.Column="1"
                                                                Header="End (seconds)"
                                                                Minimum="0.01"
                                                                SpinButtonPlacementMode="Compact"
                                                                ValueChanged="SceneTimingNumberBox_ValueChanged" />
                                                        </Grid>
                                                        <TextBox
                                                            x:Name="ScenePromptTextBox"
                                                            AcceptsReturn="True"
                                                            Header="Prompt"
                                                            Height="106"
                                                            TextChanged="ScenePromptTextBox_TextChanged"
                                                            TextWrapping="Wrap" />
                                                        <TextBox
                                                            x:Name="SceneNegativePromptTextBox"
                                                            AcceptsReturn="True"
                                                            Header="Negative prompt"
                                                            Height="76"
                                                            TextChanged="ScenePromptTextBox_TextChanged"
                                                            TextWrapping="Wrap" />

                                                        <Expander
                                                            Header="Motion storyboard and continuity"
                                                            IsExpanded="True">
                                                            <StackPanel Padding="0,10,0,0" Spacing="10">
                                                                <Grid ColumnSpacing="10">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBox
                                                                        x:Name="SceneSettingTextBox"
                                                                        Header="Setting and geography"
                                                                        PlaceholderText="Location, layout, landmarks, and spatial relationships to preserve"
                                                                        TextChanged="ScenePromptTextBox_TextChanged"
                                                                        TextWrapping="Wrap" />
                                                                    <TextBox
                                                                        x:Name="SceneShotTypeTextBox"
                                                                        Grid.Column="1"
                                                                        Header="Shot type and composition"
                                                                        PlaceholderText="Framing, angle, lens feel, and subject placement"
                                                                        TextChanged="ScenePromptTextBox_TextChanged"
                                                                        TextWrapping="Wrap" />
                                                                </Grid>
                                                                <TextBox
                                                                    x:Name="SceneCharacterLockTextBox"
                                                                    Header="Character lock"
                                                                    PlaceholderText="Immutable identity, face, silhouette, wardrobe, and signature props"
                                                                    TextChanged="ScenePromptTextBox_TextChanged"
                                                                    TextWrapping="Wrap" />
                                                                <TextBox
                                                                    x:Name="SceneStyleLockTextBox"
                                                                    Header="Style lock"
                                                                    PlaceholderText="Immutable palette, texture, lighting language, and rendering style"
                                                                    TextChanged="ScenePromptTextBox_TextChanged"
                                                                    TextWrapping="Wrap" />
                                                                <TextBox
                                                                    x:Name="SceneStartStateTextBox"
                                                                    Header="Start state (first frame)"
                                                                    PlaceholderText="Opening pose, object placement, screen direction, and camera position"
                                                                    TextChanged="ScenePromptTextBox_TextChanged"
                                                                    TextWrapping="Wrap" />
                                                                <TextBox
                                                                    x:Name="SceneSubjectTextBox"
                                                                    Header="Subject in this shot"
                                                                    PlaceholderText="Who or what is visible in this scene"
                                                                    TextChanged="ScenePromptTextBox_TextChanged"
                                                                    TextWrapping="Wrap" />
                                                                <TextBox
                                                                    x:Name="SceneActionTextBox"
                                                                    Header="Visible shot action"
                                                                    PlaceholderText="What the subject visibly does through progressive poses"
                                                                    TextChanged="ScenePromptTextBox_TextChanged"
                                                                    TextWrapping="Wrap" />
                                                                <Grid ColumnSpacing="10">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBox
                                                                        x:Name="SceneCameraTextBox"
                                                                        Header="Camera move"
                                                                        PlaceholderText="Camera motion only"
                                                                        TextChanged="ScenePromptTextBox_TextChanged"
                                                                        TextWrapping="Wrap" />
                                                                    <TextBox
                                                                        x:Name="SceneMotionTextBox"
                                                                        Grid.Column="1"
                                                                        Header="Subject motion"
                                                                        PlaceholderText="Body, object, cloth, or prop movement"
                                                                        TextChanged="ScenePromptTextBox_TextChanged"
                                                                        TextWrapping="Wrap" />
                                                                </Grid>
                                                                <TextBox
                                                                    x:Name="SceneEnvironmentMotionTextBox"
                                                                    Header="Environment motion"
                                                                    PlaceholderText="Atmosphere, particles, water, light, fabric, or background movement"
                                                                    TextChanged="ScenePromptTextBox_TextChanged"
                                                                    TextWrapping="Wrap" />
                                                                <TextBox
                                                                    x:Name="SceneEndStateTextBox"
                                                                    Header="End state (last frame)"
                                                                    PlaceholderText="Final pose, object placement, screen direction, and camera position for the next scene"
                                                                    TextChanged="ScenePromptTextBox_TextChanged"
                                                                    TextWrapping="Wrap" />
                                                                <TextBox
                                                                    x:Name="SceneContinuityTextBox"
                                                                    Header="Continuity contract"
                                                                    PlaceholderText="Identity, wardrobe, palette, world, and screen direction to carry forward"
                                                                    TextChanged="ScenePromptTextBox_TextChanged"
                                                                    TextWrapping="Wrap" />
                                                                <TextBox
                                                                    x:Name="SceneTransitionTextBox"
                                                                    Header="Transition"
                                                                    PlaceholderText="Match action, dissolve, or motivated impact cut"
                                                                    TextChanged="ScenePromptTextBox_TextChanged"
                                                                    TextWrapping="Wrap" />
                                                            </StackPanel>
                                                        </Expander>

                                                        <Grid ColumnSpacing="8" RowSpacing="8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>
                                                            <Button
                                                                x:Name="MoveSceneEarlierButton"
                                                                Click="MoveSceneEarlierButton_Click"
                                                                Content="Move earlier"
                                                                HorizontalAlignment="Stretch" />
                                                            <Button
                                                                x:Name="MoveSceneLaterButton"
                                                                Grid.Column="1"
                                                                Click="MoveSceneLaterButton_Click"
                                                                Content="Move later"
                                                                HorizontalAlignment="Stretch" />
                                                            <Button
                                                                x:Name="ApproveSceneButton"
                                                                Grid.Column="2"
                                                                Click="ApproveSceneButton_Click"
                                                                Content="Approve"
                                                                HorizontalAlignment="Stretch" />
                                                            <Button
                                                                x:Name="LockSceneButton"
                                                                Grid.Row="1"
                                                                Click="LockSceneButton_Click"
                                                                Content="Lock"
                                                                HorizontalAlignment="Stretch" />
                                                            <Button
                                                                x:Name="RepairSceneButton"
                                                                Grid.Row="1"
                                                                Grid.Column="1"
                                                                Click="RepairSceneButton_Click"
                                                                Content="Needs repair"
                                                                HorizontalAlignment="Stretch" />
                                                            <Button
                                                                x:Name="SaveScenesButton"
                                                                Grid.Row="1"
                                                                Grid.Column="2"
                                                                Click="SaveScenesButton_Click"
                                                                Content="Save variant"
                                                                HorizontalAlignment="Stretch"
                                                                Style="{StaticResource AccentButtonStyle}" />
                                                        </Grid>
                                                        <TextBlock
                                                            x:Name="CurationStatusText"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </ScrollViewer>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </TabViewItem>
                                <TabViewItem Header="Raw JSON" IsClosable="False">
                                    <TextBox
                                        x:Name="RawPlanTextBox"
                                        AcceptsReturn="True"
                                        AutomationProperties.AutomationId="Planner.RawJson"
                                        FontFamily="Consolas"
                                        IsReadOnly="True"
                                        TextWrapping="NoWrap"
                                        ScrollViewer.VerticalScrollBarVisibility="Auto" />
                                </TabViewItem>
                            </TabView>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
