<Page
    x:Class="EdmgStudio.WinUI.Pages.EdmgDirectorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="WideLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="720" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="NarrowLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="BridgeSecondColumn.Width" Value="0" />
                        <Setter Target="VariantComboBox.(Grid.Row)" Value="1" />
                        <Setter Target="VariantComboBox.(Grid.Column)" Value="0" />
                        <Setter Target="ProjectDetailsLabelColumn.Width" Value="120" />
                        <Setter Target="ContextLabelColumn.Width" Value="120" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="32,28,32,48" Spacing="16" MaxWidth="1120" HorizontalAlignment="Stretch">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="EDMG Director" Style="{ThemeResource TitleTextBlockStyle}" />
                        <TextBlock
                            Text="Coordinate creative direction, reactive behavior, editorial assembly, and production handoffs without leaving the active Studio session."
                            TextWrapping="Wrap"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Button
                        x:Name="RefreshProjectButton"
                        Grid.Column="1"
                        AccessKey="R"
                        AutomationProperties.AutomationId="Director.RefreshProject"
                        Click="RefreshProject_Click"
                        Content="Refresh" />
                </Grid>

                <InfoBar
                    x:Name="StatusInfoBar"
                    AutomationProperties.AutomationId="Director.Status"
                    IsClosable="True"
                    IsOpen="False" />

                <Border Style="{StaticResource StudioCardBorderStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Story Bible and scenes" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <TextBox x:Name="StoryThemeBox" Header="Project theme" AutomationProperties.AutomationId="Director.StoryTheme" />
                        <TextBox x:Name="StoryStyleBox" Header="Visual style" AutomationProperties.AutomationId="Director.StoryStyle" />
                        <TextBox x:Name="DirectorInstructionBox" Header="Direction for Qwen3-VL" TextWrapping="Wrap" AcceptsReturn="True" AutomationProperties.AutomationId="Director.Instruction" />
                        <CommandBar DefaultLabelPosition="Right">
                            <AppBarButton Label="Generate draft" Icon="Play" Click="GenerateDirector_Click" AutomationProperties.AutomationId="Director.Generate" />
                            <AppBarButton Label="Review selected job" Icon="Refresh" Click="ReviewDirector_Click" AutomationProperties.AutomationId="Director.ReviewDraft" />
                            <AppBarButton x:Name="ApplyDirectorDraftButton" Label="Apply reviewed draft" Icon="Accept" Click="ApplyDirectorDraft_Click" IsEnabled="False" AutomationProperties.AutomationId="Director.ApplyDraft" />
                            <AppBarButton Label="Open Queue" Icon="List" Click="OpenQueue_Click" />
                        </CommandBar>
                        <TextBlock Text="Generation uses saved scenes and returns a draft. Select a job in Queue to review it here; cancellation is available in Queue." TextWrapping="Wrap" />
                        <TextBox x:Name="DirectorDraftBox" Header="Draft review" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="300" AutomationProperties.AutomationId="Director.Draft" />
                        <Expander Header="Advanced: structured scenes" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <TextBox x:Name="SceneSpecsBox" Header="SceneSpecs (JSON array with scene_id, start_sample, end_sample and intent)" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="160" MaxHeight="360" AutomationProperties.AutomationId="Director.SceneSpecs" />
                        </Expander>
                        <CommandBar DefaultLabelPosition="Right">
                            <AppBarButton x:Name="SaveDirectorButton" Label="Save direction" Icon="Save" Click="SaveDirector_Click" AutomationProperties.AutomationId="Director.SaveDocument" />
                            <AppBarButton x:Name="CompileDirectorButton" Label="Prepare prompts" Icon="Preview" Click="CompileDirector_Click" AutomationProperties.AutomationId="Director.CompilePrompts" />
                        </CommandBar>
                        <ComboBox x:Name="PromptEngineBox" Header="Prompt preview engine" SelectedIndex="0">
                            <ComboBoxItem Content="HunyuanVideo-1.5" Tag="hunyuan_video15" />
                            <ComboBoxItem Content="LTX-2.5" Tag="ltx_25" />
                            <ComboBoxItem Content="External provider" Tag="external" />
                        </ComboBox>
                        <TextBox x:Name="PromptPreviewBox" Header="Prepared prompts" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="320" AutomationProperties.AutomationId="Director.PromptPreview" />
                        <TextBlock Text="Preparing prompts does not start generation. Save direction before preparing prompts." TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource StudioCardBorderStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Production bridge" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <TextBlock
                            Text="Project and variant choices are shared immediately with Planner, Reactive Lab, Workspace, Timeline, Render, Review, and Studio Forge."
                            TextWrapping="Wrap"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Grid ColumnSpacing="16" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition x:Name="BridgeSecondColumn" Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ComboBox
                                x:Name="ProjectComboBox"
                                AutomationProperties.AutomationId="Director.Project"
                                DisplayMemberPath="Name"
                                Header="Active project"
                                HorizontalAlignment="Stretch"
                                PlaceholderText="Choose a project"
                                SelectionChanged="ProjectComboBox_SelectionChanged" />
                            <ComboBox
                                x:Name="VariantComboBox"
                                Grid.Column="1"
                                AutomationProperties.AutomationId="Director.Variant"
                                DisplayMemberPath="Label"
                                Header="Selected plan variant"
                                HorizontalAlignment="Stretch"
                                PlaceholderText="Generate a plan first"
                                SelectionChanged="VariantComboBox_SelectionChanged" />
                        </Grid>
                        <Grid ColumnSpacing="24" RowSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="ProjectDetailsLabelColumn" Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Project ID" FontWeight="SemiBold" />
                            <TextBlock x:Name="ProjectIdText" Grid.Column="1" Text="—" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="1" Text="Analysis" FontWeight="SemiBold" />
                            <TextBlock x:Name="AnalysisText" Grid.Row="1" Grid.Column="1" Text="Not loaded" />
                            <TextBlock Grid.Row="2" Text="Creative plan" FontWeight="SemiBold" />
                            <TextBlock x:Name="PlanText" Grid.Row="2" Grid.Column="1" Text="Not loaded" />
                            <TextBlock Grid.Row="3" Text="Project health" FontWeight="SemiBold" />
                            <TextBlock x:Name="HealthText" Grid.Row="3" Grid.Column="1" Text="Not checked" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="4" Text="Recommended next step" FontWeight="SemiBold" />
                            <StackPanel Grid.Row="4" Grid.Column="1" Spacing="8">
                                <TextBlock x:Name="NextStepText" Text="Choose a project to begin." TextWrapping="Wrap" />
                                <Button
                                    x:Name="NextStepButton"
                                    HorizontalAlignment="Left"
                                    AutomationProperties.AutomationId="Director.NextStep"
                                    Click="NextStepButton_Click"
                                    Content="Open Projects" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource StudioCardBorderStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Current handoff context" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <TextBlock
                            Text="Director carries the current source, artifact, queue job, timeline focus, and render intent into the next native surface."
                            TextWrapping="Wrap"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Grid ColumnSpacing="24" RowSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="ContextLabelColumn" Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Source asset" FontWeight="SemiBold" />
                            <TextBlock x:Name="SourceAssetText" Grid.Column="1" Text="None selected" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="1" Text="Output artifact" FontWeight="SemiBold" />
                            <TextBlock x:Name="ArtifactText" Grid.Row="1" Grid.Column="1" Text="None selected" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="2" Text="Queue job" FontWeight="SemiBold" />
                            <TextBlock x:Name="JobText" Grid.Row="2" Grid.Column="1" Text="None selected" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="3" Text="Timeline focus" FontWeight="SemiBold" />
                            <TextBlock x:Name="TimelineFocusText" Grid.Row="3" Grid.Column="1" Text="No focused time" />
                            <TextBlock Grid.Row="4" Text="Render context" FontWeight="SemiBold" />
                            <TextBlock x:Name="RenderContextText" Grid.Row="4" Grid.Column="1" Text="Default" TextWrapping="Wrap" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource StudioCardBorderStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Direct the workflow" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <TextBlock
                            Text="Planner owns conductor intent and director presets; Reactive Lab owns audio mappings; the production surfaces preserve the selected session context."
                            TextWrapping="Wrap"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <ItemsControl x:Name="ProductionActions">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <Button Margin="0,0,8,8" Content="AI Planner Lab" Click="OpenPlanner_Click"
                                    AutomationProperties.AutomationId="Director.OpenPlanner" />
                            <Button Margin="0,0,8,8" Content="Reactive Lab" Click="OpenReactive_Click"
                                    AutomationProperties.AutomationId="Director.OpenReactive" />
                            <Button Margin="0,0,8,8" Content="Workspace" Click="OpenWorkspace_Click"
                                    AutomationProperties.AutomationId="Director.OpenWorkspace" />
                            <Button Margin="0,0,8,8" Content="Timeline" Click="OpenTimeline_Click"
                                    AutomationProperties.AutomationId="Director.OpenTimeline" />
                            <Button Margin="0,0,8,8" Content="Render" Click="OpenRender_Click"
                                    AutomationProperties.AutomationId="Director.OpenRender" />
                            <Button Margin="0,0,8,8" Content="Queue" Click="OpenQueue_Click"
                                    AutomationProperties.AutomationId="Director.OpenQueue" />
                            <Button Margin="0,0,8,8" Content="Outputs" Click="OpenOutputs_Click"
                                    AutomationProperties.AutomationId="Director.OpenOutputs" />
                            <Button Margin="0,0,8,8" Content="Review" Click="OpenReview_Click"
                                    AutomationProperties.AutomationId="Director.OpenReview" />
                            <Button Margin="0,0,8,8" Content="Studio Forge" Click="OpenForge_Click"
                                    AutomationProperties.AutomationId="Director.OpenForge" />
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <InfoBar
                    IsClosable="False"
                    IsOpen="True"
                    Severity="Informational"
                    Title="Native service lifecycle"
                    Message="WinUI uses the configured Studio backend supervisor. Electron-only embedded sidecar controls are intentionally not reproduced here." />
            </StackPanel>
        </ScrollViewer>
        <ProgressBar
            x:Name="BusyIndicator"
            AutomationProperties.Name="Loading Director project"
            IsIndeterminate="True"
            VerticalAlignment="Top"
            Visibility="Collapsed" />
    </Grid>
</Page>
